# Optional: URL of the BytePath authentication backend (no trailing slash).
# When omitted, the app uses its local development auth adapter.
VITE_AUTH_API_URL=http://localhost:8081/api
# Configure the matching OAuth client IDs in backend environment variables.
# Google sign-in uses VITE_GOOGLE_CLIENT_ID in the browser and GOOGLE_CLIENT_ID on the backend.
VITE_GOOGLE_CLIENT_ID=

# Public Razorpay key ID only (never put the secret in frontend/.env)
VITE_RAZORPAY_KEY_ID=
